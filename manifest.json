{
  "manifest_version": 3,
  "name": "LMS Auto-Pilot — AI Module & Task Solver",
  "version": "1.0.0",
  "description": "Ekstensi Chrome otomatis berbasis AI untuk menyelesaikan modul LMS: simulasi tombol interaktif, jalankan program, pilihan ganda, dan esai secara Full Auto-Pilot.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LMS Auto-Pilot Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/storage.js",
        "content/scanner.js",
        "content/executor.js",
        "content/hud.js",
        "content/autopilot.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
